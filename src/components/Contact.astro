---
import { siteConfig } from "../config";
const primary = siteConfig.contact.primary;
const alternative = siteConfig.contact.alternative;
---

<section id="contact" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-white/50">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900"
        >
          Contact
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
        <p class="mt-6 text-base sm:text-lg text-gray-600 leading-relaxed">
          Ready to elevate your digital presence? Reach out through our primary
          studio channels or our alternative international desk. We respond to all
          inquiries within 24 business hours.
        </p>

        <!-- Quick Help Note -->
        <div class="mt-8 p-5 bg-gray-50 border border-gray-200 rounded-xl space-y-2">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs uppercase tracking-wider font-semibold text-gray-700">Studio Availability</span>
          </div>
          <p class="text-sm text-gray-600">
            Currently accepting new clients for Q1/Q2 editorial and digital engineering commissions.
          </p>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-8">
        <!-- Dual Contact Cards: Primary vs Alternative -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Primary Contact Card -->
          <div
            class="relative p-6 sm:p-8 bg-white rounded-2xl border-2 border-indigo-100 shadow-sm hover:shadow-md transition-all duration-300 group"
          >
            <div class="flex items-center justify-between mb-4">
              <span
                class="px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white rounded-full"
                style={`background-color: ${siteConfig.accentColor}`}
              >
                {primary.label}
              </span>
              <span class="text-xs font-mono text-gray-400">01 / NYC HQ</span>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2">
              {primary.locationName}
            </h3>

            <div class="space-y-4 text-sm text-gray-600 mt-4">
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-indigo-600 flex-shrink-0 mt-0.5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
                  <path d="M3 7l9 6l9 -6"></path>
                </svg>
                <div>
                  <div class="text-xs uppercase tracking-wider text-gray-400 font-medium">Primary Email</div>
                  <a
                    href={`mailto:${primary.email}`}
                    class="font-medium text-gray-900 hover:text-indigo-600 transition-colors"
                  >
                    {primary.email}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-indigo-600 flex-shrink-0 mt-0.5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"></path>
                </svg>
                <div>
                  <div class="text-xs uppercase tracking-wider text-gray-400 font-medium">Primary Telephone</div>
                  <a
                    href={`tel:${primary.phone.replace(/[^+\d]/g, "")}`}
                    class="font-medium text-gray-900 hover:text-indigo-600 transition-colors"
                  >
                    {primary.phone}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-indigo-600 flex-shrink-0 mt-0.5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
                  <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"></path>
                </svg>
                <div>
                  <div class="text-xs uppercase tracking-wider text-gray-400 font-medium">Studio Address</div>
                  <address class="not-italic text-gray-700 leading-snug">
                    {primary.address}
                  </address>
                </div>
              </div>

              <div class="pt-2 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
                <span>Business Hours:</span>
                <span class="font-medium text-gray-700">{primary.hours}</span>
              </div>
            </div>
          </div>

          <!-- Alternative Contact Card -->
          <div
            class="relative p-6 sm:p-8 bg-gray-50 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all duration-300 group"
          >
            <div class="flex items-center justify-between mb-4">
              <span
                class="px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-gray-800 text-white rounded-full"
              >
                {alternative.label}
              </span>
              <span class="text-xs font-mono text-gray-400">02 / LDN HUB</span>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2">
              {alternative.locationName}
            </h3>

            <div class="space-y-4 text-sm text-gray-600 mt-4">
              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-700 flex-shrink-0 mt-0.5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
                  <path d="M3 7l9 6l9 -6"></path>
                </svg>
                <div>
                  <div class="text-xs uppercase tracking-wider text-gray-400 font-medium">Alternative Email</div>
                  <a
                    href={`mailto:${alternative.email}`}
                    class="font-medium text-gray-900 hover:text-indigo-600 transition-colors"
                  >
                    {alternative.email}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-700 flex-shrink-0 mt-0.5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"></path>
                </svg>
                <div>
                  <div class="text-xs uppercase tracking-wider text-gray-400 font-medium">Alternative Telephone</div>
                  <a
                    href={`tel:${alternative.phone.replace(/[^+\d]/g, "")}`}
                    class="font-medium text-gray-900 hover:text-indigo-600 transition-colors"
                  >
                    {alternative.phone}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gray-700 flex-shrink-0 mt-0.5"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
                  <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"></path>
                </svg>
                <div>
                  <div class="text-xs uppercase tracking-wider text-gray-400 font-medium">European Address</div>
                  <address class="not-italic text-gray-700 leading-snug">
                    {alternative.address}
                  </address>
                </div>
              </div>

              <div class="pt-2 border-t border-gray-200 flex items-center justify-between text-xs text-gray-500">
                <span>Weekend / Priority:</span>
                <span class="font-medium text-gray-700">{alternative.hours}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Direct Inquiry Form -->
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-1">
            Send a Project Brief
          </h3>
          <p class="text-sm text-gray-600 mb-6">
            Fill in the details below and our creative team will review your project requirements.
          </p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Your Name *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Alex Morgan"
                  class="w-full px-4 py-2.5 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                />
              </div>
              <div>
                <label for="contact-email" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="alex@company.com"
                  class="w-full px-4 py-2.5 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-channel" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Routing Preference
                </label>
                <select
                  id="contact-channel"
                  name="channel"
                  class="w-full px-4 py-2.5 rounded-lg bg-white border border-gray-300 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                >
                  <option value="primary">Primary Studio (New York)</option>
                  <option value="alternative">Alternative Desk (London & Urgent)</option>
                  <option value="support">Technical Support</option>
                </select>
              </div>
              <div>
                <label for="contact-service" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Service of Interest
                </label>
                <select
                  id="contact-service"
                  name="service"
                  class="w-full px-4 py-2.5 rounded-lg bg-white border border-gray-300 text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
                >
                  <option>Full Digital Experience (Web + Brand)</option>
                  <option>Creative Direction & Editorial Design</option>
                  <option>Full-Stack Web Engineering</option>
                  <option>Design Systems & Motion</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                Project Overview & Timeline *
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                placeholder="Tell us about your brand goals, target timeline, and budget parameters..."
                class="w-full px-4 py-2.5 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
              ></textarea>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span class="text-xs text-gray-500">
                🔒 We respect your privacy. No spam ever.
              </span>
              <button
                type="submit"
                id="contact-submit-btn"
                class="px-6 py-3 rounded-lg text-white font-medium text-sm transition-all duration-300 hover:opacity-95 active:scale-95 shadow-sm"
                style={`background-color: ${siteConfig.accentColor}`}
              >
                Submit Inquiry
              </button>
            </div>

            <!-- Form Success Notification State -->
            <div
              id="form-success-banner"
              class="hidden p-4 mt-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-sm flex items-start gap-3"
            >
              <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <div>
                <p class="font-semibold">Thank you for reaching out to The Creative Edit!</p>
                <p class="text-xs text-emerald-700 mt-0.5">
                  Your message has been received by our studio dispatch team. We will review your brief and respond within 24 business hours.
                </p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  const successBanner = document.getElementById("form-success-banner");
  const submitBtn = document.getElementById("contact-submit-btn");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.setAttribute("disabled", "true");
      submitBtn.textContent = "Transmitting...";
    }

    setTimeout(() => {
      if (successBanner) {
        successBanner.classList.remove("hidden");
      }
      if (form instanceof HTMLFormElement) {
        form.reset();
      }
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.textContent = "Sent Successfully ✓";
        setTimeout(() => {
          submitBtn.textContent = "Submit Another Inquiry";
        }, 3000);
      }
    }, 600);
  });
</script>
